# Copy to .env and edit.

# Tailnet service to proxy. Use the full MagicDNS name (not a 100.x address)
# so the TLS certificate matches. Port defaults to 443 for https://.
UPSTREAM=https://myservice.tail1234.ts.net

# Address to listen on. Defaults to loopback (this machine only); use 0.0.0.0
# to serve the local network, or a specific interface IP. Space-separate several.
LISTEN_ADDR=127.0.0.1

# Port to listen on.
LISTEN_PORT=8080

# Clients must send `Authorization: Bearer <API_KEY>`.
# Generate with: openssl rand -hex 32
# Set it empty (API_KEY=) to let any LAN client use the proxy without a key.
API_KEY=change-me

# Optional key for the upstream itself, sent as `Authorization: Bearer <UPSTREAM_API_KEY>`.
# Leave empty if the upstream needs no auth; the client's key is never forwarded.
UPSTREAM_API_KEY=
